{
  "rules": {
    ".read": false,
    ".write": false,
    "clock": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now"
      }
    },
    "redeemed": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.exists()) || (data.exists() && (!newData.exists() || data.val() === newData.val())))",
        ".validate": "newData.isString() && newData.val() === 'LM-BEISPIEL'"
      }
    },
    "names": {
      "$key": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && root.child('users').child(auth.uid).child('key').val() === $key) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
        ".validate": "newData.isString() && newData.val() === auth.uid && $key.matches(/^[a-zäöüß0-9_-][a-zäöüß0-9_-]+[a-zäöüß0-9_-]$/) && $key.length <= 16 && !root.child('blockednames').child($key).exists()"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && root.child('redeemed').child($uid).exists()",
        ".validate": "newData.hasChildren(['name', 'key', 'created'])",
        "name": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-zÄÖÜäöüß0-9_-][A-Za-zÄÖÜäöüß0-9 _-]+[A-Za-zÄÖÜäöüß0-9_-]$/) && !newData.val().matches(/^.*  .*$/) && newData.val().length <= 16 && newData.parent().child('key').val() === newData.val().toLowerCase().replace(' ', '_') && (!data.exists() || newData.val() === data.val() || root.child('blockednames').child(data.parent().child('key').val()).exists())"
        },
        "key": {
          ".validate": "newData.isString() && newData.val() === newData.parent().child('name').val().toLowerCase().replace(' ', '_') && (!root.child('names').child(newData.val()).exists() || root.child('names').child(newData.val()).val() === $uid) && (!data.exists() || newData.val() === data.val() || root.child('blockednames').child(data.val()).exists()) && ((data.exists() && newData.val() === data.val()) || (!root.child('blockednames').child(newData.val()).exists() && !newData.val().replace('_', '').replace('-', '').replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's').replace('7', 't').replace('ß', 'ss').replace('ä', 'ae').replace('ö', 'oe').replace('ü', 'ue').matches(/^.*(admin|behindert|bitch|ficken|ficker|fotze|fuck|hitler|hurensohn|lastmile|moderator|mongo|nazi|neger|nigga|nigger|nutte|pimmel|porn|scheiss|schwuchtel|shit|spast|vergewalt|wichser).*$/) && !newData.val().replace('_', '').replace('-', '').replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's').replace('7', 't').replace('ß', 'ss').replace('ä', 'ae').replace('ö', 'oe').replace('ü', 'ue').matches(/^(admin|administrator|anthropic|arsch|claude|depp|dumm|fick|gast|guest|heil|hure|idiot|isis|kacke|kz|lastmile|moderator|null|penis|root|server|sex|sieg|staff|support|system|team|terror|undefined|vagina)[0-9]*$/)))"
        },
        "created": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).exists()",
        "$slot": {
          ".validate": "$slot.matches(/^[so]_[A-Za-z0-9_-]+$/) && $slot.length <= 62 && newData.hasChildren(['t', 'v', 'data']) && ($slot.beginsWith('o_') ? (newData.child('sess').exists() && newData.child('sess').val() === root.child('sessions').child($uid).child($slot).child('sess').val()) : !newData.child('sess').exists())",
          "t": {
            ".validate": "newData.val() === now"
          },
          "v": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
          },
          "data": {
            ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 400000"
          },
          "sess": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "savemeta": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).exists()",
        "$slot": {
          ".validate": "$slot.matches(/^[so]_[A-Za-z0-9_-]+$/) && $slot.length <= 62 && newData.hasChildren(['t', 'v', 'info'])",
          "t": {
            ".validate": "newData.val() === now"
          },
          "v": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
          },
          "info": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).exists()",
        "$slot": {
          ".validate": "$slot.matches(/^o_[A-Za-z0-9_-]+$/) && $slot.length <= 62 && newData.hasChildren(['sess', 't'])",
          "sess": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "board": {
      "$ck": {
        "$scope": {
          ".read": "auth != null",
          ".indexOn": [
            "p",
            "g",
            "l",
            "r"
          ],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).exists()",
            ".validate": "($ck === '_global' || $ck.matches(/^[A-Za-z0-9_-]{3,40}$/)) && ($scope === 'all' || $scope === 'day' || $scope === 'week') && newData.hasChildren(['n', 'g', 'p', 't'])",
            "n": {
              ".validate": "newData.isString() && newData.val() === root.child('users').child($uid).child('name').val()"
            },
            "c": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "p": {
              ".validate": "newData.isNumber() && ($scope === 'all' ? newData.val() === 0 : ($scope === 'day' ? (newData.val() <= (now - 7200000) / 86400000 && newData.val() > (now - 7200000) / 86400000 - 1) : (newData.val() <= ((now - 7200000) / 86400000 + 3) / 7 && newData.val() > ((now - 7200000) / 86400000 + 3) / 7 - 1))) && (!data.exists() || newData.val() >= data.val())"
            },
            "g": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && ((data.exists() && data.parent().child('p').val() === newData.parent().child('p').val()) ? (newData.val() >= data.val() && newData.val() <= data.val() + 10 * (now - data.parent().child('t').val()) / 1000 + 5000) : newData.val() <= 10 * (((now - root.child('users').child($uid).child('created').val()) / 1000) < ($scope === 'day' ? 86400 : ($scope === 'week' ? 604800 : 1000000000)) ? ((now - root.child('users').child($uid).child('created').val()) / 1000) : ($scope === 'day' ? 86400 : ($scope === 'week' ? 604800 : 1000000000))) + 5000)"
            },
            "l": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0 && newData.val() <= 1.5 * (((now - root.child('users').child($uid).child('created').val()) / 1000) < ($scope === 'day' ? 86400 : ($scope === 'week' ? 604800 : 1000000000)) ? ((now - root.child('users').child($uid).child('created').val()) / 1000) : ($scope === 'day' ? 86400 : ($scope === 'week' ? 604800 : 1000000000))) + 200 && (!(data.exists() && data.parent().child('p').val() === newData.parent().child('p').val()) || newData.val() >= data.val())"
            },
            "r": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "clans": {
      "$cid": {
        ".read": "auth != null",
        ".write": "auth != null && ((root.child('users').child(auth.uid).exists() && ((!data.exists() && newData.child('o').val() === auth.uid) || data.child('o').val() === auth.uid)) || (root.child('admins').child(auth.uid).exists() && !newData.exists()))",
        ".validate": "$cid.matches(/^[A-Za-z0-9]{12,24}$/) && newData.hasChildren(['n', 'k', 'o', 't'])",
        "n": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-zÄÖÜäöüß0-9_-][A-Za-zÄÖÜäöüß0-9 _-]+[A-Za-zÄÖÜäöüß0-9_-]$/) && !newData.val().matches(/^.*  .*$/) && newData.val().length <= 16 && newData.parent().child('k').val() === newData.val().toLowerCase().replace(' ', '_') && (!data.exists() || newData.val() === data.val())"
        },
        "k": {
          ".validate": "newData.isString() && (!root.child('clannames').child(newData.val()).exists() || root.child('clannames').child(newData.val()).val() === $cid) && (data.exists() ? newData.val() === data.val() : (!root.child('blockednames').child(newData.val()).exists() && !newData.val().replace('_', '').replace('-', '').replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's').replace('7', 't').replace('ß', 'ss').replace('ä', 'ae').replace('ö', 'oe').replace('ü', 'ue').matches(/^.*(admin|behindert|bitch|ficken|ficker|fotze|fuck|hitler|hurensohn|lastmile|moderator|mongo|nazi|neger|nigga|nigger|nutte|pimmel|porn|scheiss|schwuchtel|shit|spast|vergewalt|wichser).*$/) && !newData.val().replace('_', '').replace('-', '').replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's').replace('7', 't').replace('ß', 'ss').replace('ä', 'ae').replace('ö', 'oe').replace('ü', 'ue').matches(/^(admin|administrator|anthropic|arsch|claude|depp|dumm|fick|gast|guest|heil|hure|idiot|isis|kacke|kz|lastmile|moderator|null|penis|root|server|sex|sieg|staff|support|system|team|terror|undefined|vagina)[0-9]*$/)))"
        },
        "o": {
          ".validate": "newData.isString() && (data.exists() ? (newData.val() === data.val() || root.child('members').child($cid).child(newData.val()).exists()) : newData.val() === auth.uid)"
        },
        "t": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "clannames": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && !data.exists() && root.child('clans').child(newData.val()).child('o').val() === auth.uid && root.child('clans').child(newData.val()).child('k').val() === $key) || (!newData.exists() && data.exists() && (root.child('clans').child(data.val()).child('o').val() === auth.uid || !root.child('clans').child(data.val()).exists())) || (root.child('admins').child(auth.uid).exists() && data.exists() && !newData.exists()))",
        ".validate": "newData.isString() && $key.matches(/^[a-zäöüß0-9_-][a-zäöüß0-9_-]+[a-zäöüß0-9_-]$/) && $key.length <= 16 && !root.child('blockednames').child($key).exists()"
      }
    },
    "clansecret": {
      "$cid": {
        ".read": "auth != null && root.child('members').child($cid).child(auth.uid).exists()",
        ".write": "auth != null && root.child('clans').child($cid).child('o').val() === auth.uid",
        ".validate": "newData.isString() && newData.val().matches(/^[A-Z2-9]{8}$/)"
      }
    },
    "clancodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && !data.exists() && root.child('clans').child(newData.val()).child('o').val() === auth.uid) || (!newData.exists() && data.exists() && (root.child('clans').child(data.val()).child('o').val() === auth.uid || !root.child('clans').child(data.val()).exists())))",
        ".validate": "$code.matches(/^[A-Z2-9]{8}$/) && newData.isString() && root.child('clansecret').child(newData.val()).val() === $code"
      }
    },
    "clanof": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).exists() && (!data.exists() || newData.val() === data.val() || !root.child('members').child(data.val()).child($uid).exists())",
        ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{12,24}$/)"
      }
    },
    "members": {
      "$cid": {
        ".read": "auth != null && root.child('members').child($cid).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && root.child('users').child(auth.uid).exists() && ((auth.uid === $uid && (data.exists() || root.child('clans').child($cid).exists())) || (!newData.exists() && root.child('clans').child($cid).child('o').val() === auth.uid))",
          ".validate": "newData.hasChildren(['n', 't', 'k']) && root.child('clanof').child($uid).val() === $cid && newData.child('k').val() === root.child('clansecret').child($cid).val()",
          "n": {
            ".validate": "newData.isString() && newData.val() === root.child('users').child($uid).child('name').val()"
          },
          "t": {
            ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().length === 8"
          },
          "a": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('board').child('_global').child('all').child($uid).child('g').val()"
          },
          "d": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('board').child('_global').child('day').child($uid).child('g').val()"
          },
          "pd": {
            ".validate": "newData.isNumber() && newData.val() === root.child('board').child('_global').child('day').child($uid).child('p').val()"
          },
          "w": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('board').child('_global').child('week').child($uid).child('g').val()"
          },
          "pw": {
            ".validate": "newData.isNumber() && newData.val() === root.child('board').child('_global').child('week').child($uid).child('p').val()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "clanboard": {
      "$scope": {
        ".read": "auth != null",
        ".indexOn": [
          "p",
          "g"
        ],
        "$cid": {
          ".write": "auth != null && root.child('users').child(auth.uid).exists() && (root.child('members').child($cid).child(auth.uid).exists() || (!newData.exists() && (root.child('clans').child($cid).child('o').val() === auth.uid || root.child('admins').child(auth.uid).exists())))",
          ".validate": "($scope === 'all' || $scope === 'day' || $scope === 'week') && newData.hasChildren(['n', 'g', 'm', 'p', 't'])",
          "n": {
            ".validate": "newData.isString() && newData.val() === root.child('clans').child($cid).child('n').val()"
          },
          "g": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('m').val() * ($scope === 'all' ? 100000000 : ($scope === 'day' ? 869000 : 6053000))"
          },
          "m": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12 && newData.val() % 1 === 0"
          },
          "p": {
            ".validate": "newData.isNumber() && ($scope === 'all' ? newData.val() === 0 : ($scope === 'day' ? (newData.val() <= (now - 7200000) / 86400000 && newData.val() > (now - 7200000) / 86400000 - 1) : (newData.val() <= ((now - 7200000) / 86400000 + 3) / 7 && newData.val() > ((now - 7200000) / 86400000 + 3) / 7 - 1))) && (!data.exists() || newData.val() >= data.val())"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "blockednames": {
      ".read": "auth != null",
      "$key": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.val() === now && $key.matches(/^[a-zäöüß0-9_-][a-zäöüß0-9_-]+[a-zäöüß0-9_-]$/) && $key.length <= 16"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$slot": {
          ".write": "auth != null && ((auth.uid === $uid && root.child('users').child($uid).exists() && $slot.matches(/^s[0-9]$/) && (!data.exists() || data.child('t').val() < now - 86400000)) || (root.child('admins').child(auth.uid).exists() && !newData.exists()))",
          ".validate": "newData.hasChildren(['k', 'id', 'n', 'r', 't'])",
          "k": {
            ".validate": "newData.val() === 'p' || newData.val() === 'c'"
          },
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{12,40}$/) && newData.val() !== $uid"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "r": {
            ".validate": "newData.isString() && newData.val().matches(/^(beleidigung|hass|echt|imitation|sonst)$/)"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
